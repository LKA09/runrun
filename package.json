{
  "name": "runrun",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api:build": "tsc -p worker/tsconfig.json",
    "api:dev": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local --config worker/wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote --config worker/wrangler.jsonc",
    "api:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.16",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "better-auth": "^1.7.16",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/express": "^5.0.6",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "jpeg-js": "^0.4.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.157.0"
  }
}
